    {
      "_meta": {
        "com.warehouse/authority": "L1"
      },
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List the directed lanes between nodes by id ascending, optionally only those leaving one origin node and/or arriving at one destination node (the filters combine with AND). Open and closed lanes are both listed, distinguished by status (OPEN or CLOSED); mode is GROUND or AIR and nominalTransitMinutes is the planned transit. Each lane carries costPerUnitCents, the planner's declared marginal cost of moving one package-unit across it on one departure (integer cents; 0 means nothing declared yet), and emissionPerUnitG, the declared carbon emission of that move (grams of CO2-equivalent; 0 means nothing declared yet). Read-only; no match is an empty list.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "description": "optional filter: keep only lanes leaving this origin node; omitted means every origin"
          },
          "destination": {
            "type": "string",
            "description": "optional filter: keep only lanes arriving at this destination node; omitted means every destination"
          }
        },
        "additionalProperties": false
      },
      "name": "list_lanes",
      "outputSchema": {
        "type": "object",
        "properties": {
          "lanes": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "laneId": {
                  "type": "string"
                },
                "originNodeId": {
                  "type": "string"
                },
                "destinationNodeId": {
                  "type": "string"
                },
                "mode": {
                  "type": "string"
                },
                "nominalTransitMinutes": {
                  "type": "integer"
                },
                "status": {
                  "type": "string"
                },
                "costPerUnitCents": {
                  "type": "integer"
                },
                "emissionPerUnitG": {
                  "type": "integer"
                },
                "closedAt": {
                  "type": "string"
                }
              },
              "required": [
                "laneId",
                "originNodeId",
                "destinationNodeId",
                "mode",
                "nominalTransitMinutes",
                "status",
                "costPerUnitCents",
                "emissionPerUnitG"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "lanes"
        ],
        "additionalProperties": false
      }
    },
