                "handoffNodeId",
                "costPerPackageCents",
                "transitMinutes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "postalPrefix",
          "deliveryStationNodeId",
          "regionId",
          "assignmentVersion"
        ],
        "additionalProperties": false
      }
