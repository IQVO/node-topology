        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Resolve which delivery station serves a postal prefix: the prefix (matched exactly), the deliveryStationNodeId, the station's regionId, the assignmentVersion, and — when the area's last mile is a carrier handoff — the deliveryMode (CARRIER_HANDOFF) and the declared carrier options (carrierId, handoffNodeId, costPerPackageCents, transitMinutes); an area served by the network's own route carries no mode or options. Read-only; an unassigned prefix fails with not-found.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "postalPrefix": {
            "type": "string",
            "description": "the postal prefix to resolve, matched exactly, e.g. 013"
          }
        },
        "required": [
          "postalPrefix"
        ],
        "additionalProperties": false
      },
      "name": "resolve_service_area",
      "outputSchema": {
        "type": "object",
        "properties": {
          "postalPrefix": {
            "type": "string"
          },
          "deliveryStationNodeId": {
            "type": "string"
          },
          "regionId": {
            "type": "string"
          },
          "assignmentVersion": {
            "type": "integer"
          },
          "deliveryMode": {
            "type": "string"
          },
          "carriers": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "carrierId": {
                  "type": "string"
                },
